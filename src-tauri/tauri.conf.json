{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rotellario",
  "version": "1.0.0",
  "identifier": "com.qtracademy.rotellario",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Rotellario",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Dizionario della Lingua Rotellese",
    "longDescription": "Rotellario — il dizionario della Lingua Rotellese. Tutti i lemmi restano salvati in locale sul dispositivo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
